{
  "name": "seshi-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 'packages/*/test/**/*.test.ts' 'test/**/*.test.ts'",
    "test:core": "node --test 'packages/core/test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "ws": "^8.18.0"
  },
  "bin": {
    "seshi": "packages/cli/src/index.ts"
  }
}
