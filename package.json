{
  "name": "seshi-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 'packages/*/test/**/*.test.ts' 'test/**/*.test.ts'",
    "test:core": "node --test 'packages/core/test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node test/smoke/relay-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  },
  "bin": {
    "seshi": "packages/cli/src/index.ts"
  }
}
